# script-src hashes whitelist the page's inline <script> snippets:
#   1) Organization JSON-LD (every page, sitewide in Base.astro)
#   2) Mobile-menu close-on-click handler (every page, in Header.astro)
#   3) Astro's IntersectionObserver loader (client:visible bootstrap)
#   4) Astro's astro-island custom-element registration
#   5) homepage JSON-LD @graph — WebSite + SoftwareApplication + FAQPage
#      (homepage only, in index.astro). The FAQ accordion itself is JS-free
#      (native <details>), so it adds no script hash.
#   6) the homepage's cinematic behaviour bundle (scroll-reveal IO, countdown,
#      scroll-progress, active-nav, count-up, card spotlight), which Astro
#      inlines because it has no imports.
# Regenerate after an Astro version bump OR after editing any of:
#   - src/scripts/cinematic.ts
#   - src/layouts/Base.astro (the Organization JSON-LD)
#   - src/pages/index.astro (the homepage JSON-LD @graph)
#   - src/components/Header.astro (the mobile-menu handler)
# One-liner that prints the unique hashes across EVERY built page (globs
# dist so new pages like 404.html are always covered):
#   pnpm build && node -e 'const fs=require("fs"),c=require("crypto"),
#   cp=require("child_process");
#   const files=cp.execSync("find dist -name \"*.html\"").toString().trim().split("\n");
#   const h=new Set();
#   for(const f of files){[...fs.readFileSync(f,"utf8").matchAll(/<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/g)]
#     .forEach(m=>h.add("sha256-"+c.createHash("sha256").update(m[1]).digest("base64")));}
#   [...h].forEach(x=>console.log(x));'
