---
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

// One canonical physical-channel endpoint, named for the show it's handed out
// at. The printed card QR (/fleetlix-rwm2026-qr.svg), an NFC chip, and a Wallet
// pass all resolve here. The page does two jobs:
//   1. presents the trial promo and links to signup with the code pre-applied
//   2. hands over our contact details as a QR the other person scans
// Renamed from /card on 12 Aug 2026 — public/_redirects 301s the old path so
// anything already printed still lands here.
// noindex: this is a card/QR entry point, not an SEO page (excluded from the
// sitemap in astro.config.mjs).

// Promo — change these in one place. The matching promo_codes row + validation
// live in the Fleetlix-App repo (see Resources/Fleetlix-Card-Promo-Implementation.md).
// PROMO_TRIAL_DAYS is the figure this page *advertises*; the one Stripe actually
// applies is `letsrecycle.trialDays` in functions/api/checkout.ts (authoritative)
// and src/config/checkout.ts (client). All three have to say the same number —
// a card promising more days than the checkout grants is a complaint waiting to
// happen. BASE_TRIAL_DAYS is what the site offers without a code, shown struck
// through so the promo reads as the upgrade it is.
const PROMO_CODE = "letsrecycle";
const PROMO_TRIAL_DAYS = 14;
const BASE_TRIAL_DAYS = 7;
// Checkout-first: land on the pricing section with the promo pre-applied, pick
// a plan, pay on Stripe, then create the login on fleetlix.app. Query before
// the hash so src/scripts/checkout.ts can read ?promo= from location.search.
const CHECKOUT_URL = `/?promo=${PROMO_CODE}#pricing`;

// The contact QR encodes a vCard 3.0 record *inline* rather than linking to
// one, so the scan resolves entirely on the other person's device: iOS Camera
// and Android both recognise the payload and offer to add the contact, with no
// network round trip and no .vcf download to find in Files afterwards. The SVG
// is the encoding — regenerate it if this record changes:
//
//   BEGIN:VCARD / VERSION:3.0 / N:Fleetlix;;;; / FN:Fleetlix
//   ORG:FLEETLIX LTD / TITLE:Fleet & waste management software
//   EMAIL;TYPE=INTERNET,WORK:contact@fleetlix.com / URL:https://fleetlix.com
//   END:VCARD
//
// Version 10, ECC M, 57x57 modules. Deliberately trimmed: adding the address
// takes it to 65x65 and the note and photo to 77x77, and module size is what
// decides whether a phone camera locks on across a stand. The full record
// stays at /fleetlix.vcf for NFC and Wallet, which have no size pressure.
const contactQr = "/fleetlix-contact-qr.svg";
---

<Base
  title={`Fleetlix — Your ${PROMO_TRIAL_DAYS}-day free trial`}
  description={`An extended ${PROMO_TRIAL_DAYS}-day Fleetlix free trial with code ${PROMO_CODE} — plus our contact card. Fleet & waste management software for UK skip hire and waste carriers.`}
  noindex={true}
>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-[color:var(--color-offwhite)] px-5 py-10 pb-[max(2.5rem,env(safe-area-inset-bottom))]"
  >
    <div class="w-full max-w-md">
      <section
        class="relative overflow-hidden rounded-3xl bg-[color:var(--color-graphite)] text-white shadow-[0_24px_60px_-24px_rgba(26,29,33,0.55)]"
      >
        <div class="px-7 pt-9 pb-8 sm:px-9">
          <img
            src="/fleetlix-logo-reversed.svg"
            alt="Fleetlix"
            width="540"
            height="140"
            class="h-11 w-auto"
          />

          <p
            class="mt-6 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[color:var(--color-amber)]"
          >
            Fleet &amp; waste management software
          </p>
          <p class="mt-3 text-[15px] leading-relaxed text-white/75">
            Jobs, compliance, routing and billing in one platform for UK skip
            hire and waste carriers. DWTS-ready as standard.
          </p>

          <!-- Promo -->
          <div
            class="mt-7 rounded-2xl border border-[color:var(--color-amber)]/30 bg-[color:var(--color-amber)]/[0.08] p-5"
          >
            <p
              class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[color:var(--color-amber)]"
            >
              Exclusive offer
            </p>
            <p class="mt-2 flex items-baseline gap-2">
              <span
                class="font-[family-name:var(--font-display)] text-3xl font-extrabold tracking-tight text-white"
                >{PROMO_TRIAL_DAYS} days free</span
              >
              <span class="text-sm font-medium text-white/45 line-through"
                >{BASE_TRIAL_DAYS} days</span
              >
            </p>
            <p class="mt-2 text-[14px] leading-relaxed text-white/70">
              Start Fleetlix on an extended free trial. Tap below and the code
              is applied at signup — or enter it manually.
            </p>

            <div
              class="mt-4 flex items-center justify-between gap-3 rounded-xl border border-dashed border-white/25 bg-white/5 px-4 py-3"
            >
              <span
                class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white/40"
                >Code</span
              >
              <span
                class="font-mono text-lg font-bold tracking-[0.12em] text-[color:var(--color-amber)]"
                >{PROMO_CODE}</span
              >
            </div>

            <a
              href={CHECKOUT_URL}
              class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-[color:var(--color-amber)] px-6 py-3.5 text-base font-semibold text-[color:var(--color-graphite)] shadow transition hover:brightness-105"
            >
              Start your free trial
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </a>
          </div>

          <!-- Save contact (secondary). This page is usually held up on one
               phone and scanned by another, so the QR is the handover: white
               tile for contrast against the graphite card, sized so the 57
               modules stay legible at 375px. Anyone who can't use a camera has
               the same details as text in the list below. -->
          <div
            class="mt-6 rounded-2xl border border-white/12 bg-white/[0.04] p-4 text-center"
          >
            <p
              class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[color:var(--color-cyan)]"
            >
              Save our details
            </p>
            <div class="mx-auto mt-4 w-full max-w-[17rem] rounded-xl bg-white p-3">
              <img
                src={contactQr}
                alt="QR code containing the Fleetlix contact card"
                width="65"
                height="65"
                class="block h-auto w-full"
              />
            </div>
            <p class="mt-4 text-[14px] leading-relaxed text-white/70">
              Point your camera at the code — your phone will offer to add
              Fleetlix to your contacts. Nothing to download.
            </p>
          </div>

          <ul class="mt-7 space-y-3 text-[15px]">
            <li class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class="h-3 w-3 shrink-0 rounded-[3px] bg-[color:var(--color-amber)]"
              ></span>
              <a
                href="mailto:contact@fleetlix.com"
                class="text-white/85 underline-offset-2 hover:underline"
                >contact@fleetlix.com</a
              >
            </li>
            <li class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class="h-3 w-3 shrink-0 rounded-[3px] bg-[color:var(--color-cyan)]"
              ></span>
              <a
                href="https://fleetlix.com"
                class="text-white/85 underline-offset-2 hover:underline"
                >fleetlix.com</a
              >
            </li>
          </ul>

          <p
            class="mt-7 text-[0.7rem] font-medium uppercase tracking-[0.14em] text-white/35"
          >
            FLEETLIX LTD · Company No. 17331348<br />
            Registered in England and Wales
          </p>
        </div>

        <div aria-hidden="true" class="flex h-2">
          <div class="flex-1 bg-[color:var(--color-amber)]"></div>
          <div class="w-1/3 bg-[color:var(--color-cyan)]"></div>
        </div>
      </section>

      <p class="mt-6 text-center text-sm text-[color:var(--color-slate)]">
        <a href="/" class="underline-offset-2 hover:underline">See the product →</a>
      </p>
    </div>
  </main>
  <SiteFooter />
</Base>
