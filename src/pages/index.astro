---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BuiltForRoad from "../components/BuiltForRoad.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import StatBand from "../components/StatBand.astro";
import FrontReveal from "../components/FrontReveal.astro";
import MotionProduct from "../components/MotionProduct.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import WhyPwa from "../components/WhyPwa.astro";
import WhoFor from "../components/WhoFor.astro";
import ComplianceCountdown from "../components/ComplianceCountdown.astro";
import Faq from "../components/Faq.astro";
import PricingSection from "../components/PricingSection.astro";
import InterestForm from "../components/InterestForm";
import CtaFooter from "../components/CtaFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SHOW_CONTACT, SHOW_PRICING } from "../config/featureFlags";
import { faqItems } from "../config/faq";

// Homepage structured data as a single @graph so the page emits ONE inline
// JSON-LD <script> (one CSP hash) rather than one per entity. @id values
// cross-link the entities and reference the sitewide Organization defined in
// Base.astro (#organization) — Google merges all JSON-LD on the page, so the
// cross-document @id reference resolves.
const homepageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://fleetlix.com/#website",
      url: "https://fleetlix.com",
      name: "Fleetlix",
      description:
        "UK-built operations software for waste, skip-hire, and haulage firms.",
      publisher: { "@id": "https://fleetlix.com/#organization" },
      inLanguage: "en-GB",
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://fleetlix.com/#software",
      name: "Fleetlix",
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Waste management software",
      operatingSystem: "Web, iOS, Android",
      description:
        "Operations platform for UK waste, skip-hire, and haulage firms. One Progressive Web App covering driver walk-around checks, yard dispatch, office workflows, and automated Waste Transfer Notes.",
      url: "https://fleetlix.com",
      image: "https://fleetlix.com/og-image.jpg",
      offers: {
        "@type": "Offer",
        priceCurrency: "GBP",
        price: "79.00",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "79.00",
          priceCurrency: "GBP",
          unitText: "MONTH",
          referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
        },
        availability: "https://schema.org/PreOrder",
        eligibleRegion: { "@type": "Country", name: "United Kingdom" },
      },
      publisher: { "@id": "https://fleetlix.com/#organization" },
      audience: {
        "@type": "BusinessAudience",
        audienceType:
          "Skip hire, waste management, and haulage operators — fleets of 1 to 80+ vehicles, United Kingdom",
      },
      featureList: [
        "DVSA-compliant driver walk-around checks",
        "Real-time dispatch and job tracking",
        "Automated Waste Transfer Notes (WTN)",
        "Office, yard, driver, and maintenance roles in one app",
        "Works offline, installs as a PWA on any device",
        "UK GDPR compliant data handling",
      ],
    },
    {
      "@type": "FAQPage",
      "@id": "https://fleetlix.com/#faq",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<Base
  title="Waste & Haulage Software for UK Fleet Operators | Fleetlix"
  description="UK-built operations software for waste, skip-hire & haulage firms. One PWA for DVSA checks, live dispatch & automated Waste Transfer Notes. From £79/mo."
>
  <Header />
  <main>
    <Hero />
    <BuiltForRoad />
    <ProductShowcase />
    <StatBand />
    <FrontReveal />
    <MotionProduct />
    <FeatureGrid />
    <WhyPwa />
    <WhoFor />
    <ComplianceCountdown />
    {SHOW_PRICING && <PricingSection />}
    <Faq />
    <InterestForm client:visible />
    {SHOW_CONTACT && <CtaFooter />}
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(homepageJsonLd)} />
  <!-- Scroll-reveal elements start at opacity 0 (md+) and wait for JS to add
       .is-visible. With JS disabled that never happens — force everything
       visible. Inline <style> is fine: style-src allows 'unsafe-inline'. -->
  <noscript>
    <style>
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        clip-path: none !important;
      }
    </style>
  </noscript>
</Base>

<script>
  import "../scripts/cinematic.ts";
</script>
