---
// /walkthrough — the full product recording, behind a click-to-load facade.
//
// The video is a plain MP4 in Supabase Storage played by a native <video>, NOT
// an embedded player. That choice is the whole privacy story: no third-party
// script runs on this page, so the only cross-origin thing that ever happens is
// the media request itself — and src/scripts/walkthrough.ts doesn't make it
// until the visitor presses play. Pressing play IS the consent, which is why
// there is no cookie banner and what /cookies §4 says in writing.
//
// Two rules that keep that true:
//   1. Never preload, prefetch or <link rel=preconnect> the video, and never
//      start it on scroll or hover. The click is the consent; take it away and
//      the cookie policy becomes false.
//   2. The CSP allows exactly one media origin (see VIDEO_ORIGIN below, mirrored
//      in public/_headers under media-src). Another host is blocked outright —
//      intended, not a bug. Disclose in /cookies before widening it.
//
// The poster is a still lifted from the video's own opening title card, so the
// facade is the frame the film-maker designed as its cover rather than an
// abstract stand-in. Astro emits avif/webp variants of it.

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Image, getImage } from "astro:assets";
import posterSource from "../assets/walkthrough-poster.jpg";
import {
  chapters,
  fmtTime,
  RUNTIME_ISO,
  RUNTIME_LABEL,
  UPLOADED_ISO,
  VIDEO_URL,
} from "../config/walkthrough";

// One fixed-width variant, used for the <video poster> the script sets on the
// element it creates. The facade below uses responsive <Image> instead; this
// only has to cover the second or two of buffering after the click, where the
// alternative is a black box.
const posterForVideo = await getImage({
  src: posterSource,
  width: 1280,
  format: "webp",
});

// VideoObject is safe to publish now that the file is real, reachable and
// measured — it was deliberately withheld while the recording was pending,
// because claiming a video that isn't there is a manual-action risk.
// `thumbnailUrl` must be an absolute URL Google can fetch, hence the Astro.site
// join rather than the bare /_astro path.
const thumbnailUrl = new URL(posterForVideo.src, Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoObject",
      "@id": "https://fleetlix.com/walkthrough#video",
      name: "Fleetlix product walkthrough",
      description:
        "A full walk-through of Fleetlix for UK waste, skip-hire and haulage operators: taking a booking, planning the day, the driver's DVSA check, proof of delivery, the weighbridge, waste transfer notes, Digital Waste Tracking, invoicing and the customer portal.",
      thumbnailUrl,
      uploadDate: UPLOADED_ISO,
      duration: RUNTIME_ISO,
      contentUrl: VIDEO_URL,
      embedUrl: "https://fleetlix.com/walkthrough",
      publisher: { "@id": "https://fleetlix.com/#organization" },
      inLanguage: "en-GB",
      isFamilyFriendly: true,
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://fleetlix.com/walkthrough#breadcrumbs",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://fleetlix.com" },
        { "@type": "ListItem", position: 2, name: "Walkthrough", item: "https://fleetlix.com/walkthrough" },
      ],
    },
  ],
};
---

<Base
  title="Fleetlix Walkthrough — See the Whole System in 10 Minutes"
  description="A full walk-through of Fleetlix: taking a booking, dispatching a driver, capturing signatures, filing the waste transfer note, and closing the month."
>
  <Header />

  <main class="bg-[color:var(--color-offwhite)]">
    <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
      <header>
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]">
          Walkthrough · {RUNTIME_LABEL} · {chapters.length} chapters
        </p>
        <h1 class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-[color:var(--color-graphite)] text-balance">
          See a job go from phone call to invoice
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-slate)] leading-relaxed">
          One recording, start to finish, on a real yard's worth of data — no
          slides and no edits that skip the awkward bits. Jump to any section
          using the chapter list below the player.
        </p>
      </header>

      <!-- Facade. The 16:9 box is sized by aspect-ratio in global.css before
           anything loads, so pressing play swaps the poster for the player
           without shifting a pixel of the page. data-src is read by
           src/scripts/walkthrough.ts and is the ONLY place the file is
           requested from. -->
      <div
        class="wt-player mt-10 overflow-hidden rounded-2xl bg-[color:var(--color-graphite)] ring-1 ring-[color:var(--color-graphite)]/15"
        data-player
        data-src={VIDEO_URL}
        data-poster={posterForVideo.src}
      >
        <button
          type="button"
          data-play
          class="group absolute inset-0 h-full w-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[color:var(--color-cyan)]"
          aria-label={`Play the Fleetlix walkthrough, ${RUNTIME_LABEL}`}
        >
          <Image
            src={posterSource}
            alt=""
            widths={[640, 960, 1280, 1920]}
            sizes="(max-width: 900px) 100vw, 900px"
            formats={["avif", "webp"]}
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <!-- Scrim: the title card is dark but not uniformly, and the play
               button has to read against every part of it. -->
          <span class="absolute inset-0 bg-[color:var(--color-graphite)]/25" aria-hidden="true"></span>
          <span class="absolute left-1/2 top-[68%] -translate-x-1/2 -translate-y-1/2 inline-flex h-16 w-16 items-center justify-center rounded-full bg-[color:var(--color-amber)] text-[color:var(--color-graphite)] shadow-xl shadow-black/40 transition-transform duration-200 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100 sm:h-20 sm:w-20">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true" class="ml-1">
              <path d="M8 5.14v13.72L19 12z" />
            </svg>
          </span>
          <span class="absolute bottom-3 left-3 rounded-full bg-black/60 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm sm:bottom-4 sm:left-4 sm:text-sm">
            Play · {RUNTIME_LABEL}
          </span>
        </button>
      </div>

      <!-- Chapters are seek targets AND the page's indexable content — which is
           why each carries a description rather than a bare label. A search
           engine can't watch the video; this is what it reads instead. -->
      <nav class="mt-10" aria-label="Chapters">
        <h2 class="font-[family-name:var(--font-display)] text-xl font-bold text-[color:var(--color-graphite)]">
          What's covered
        </h2>
        <ol class="mt-4 divide-y divide-[color:var(--color-mist)] overflow-hidden rounded-2xl border border-[color:var(--color-mist)] bg-white">
          {chapters.map((c) => (
            <li>
              <button
                type="button"
                data-at={c.at}
                class="flex w-full cursor-pointer items-start gap-4 px-4 py-4 text-left transition-colors hover:bg-[color:var(--color-offwhite)] focus-visible:bg-[color:var(--color-offwhite)] focus-visible:outline-2 focus-visible:outline-[color:var(--color-cyan)] sm:px-5"
              >
                <span class="mt-0.5 inline-flex shrink-0 items-center gap-1.5 rounded-md bg-[color:var(--color-graphite)]/6 px-2 py-1 font-[family-name:var(--font-display)] text-xs font-bold tabular-nums text-[color:var(--color-graphite)]">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.14v13.72L19 12z" />
                  </svg>
                  {fmtTime(c.at)}
                </span>
                <span>
                  <span class="block font-semibold text-[color:var(--color-graphite)]">{c.label}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-[color:var(--color-slate)]">{c.blurb}</span>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      <p class="mt-6 text-sm text-[color:var(--color-slate)]/85">
        The video loads only when you press play — nothing is requested from
        anywhere else before that.{" "}
        <a href="/cookies" class="underline underline-offset-2 hover:text-[color:var(--color-graphite)]">
          How that works
        </a>.
      </p>

      <!-- Second route out of the page: someone who watches a 10-minute
           walkthrough is the warmest traffic on the site, so the conversion
           action is here rather than a link back to the homepage. -->
      <div class="mt-14 rounded-2xl border border-[color:var(--color-mist)] bg-white p-6 md:p-8">
        <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold text-[color:var(--color-graphite)]">
          Seen enough?
        </h2>
        <p class="mt-2 text-[color:var(--color-slate)]">
          Fleetlix launches on 1 October 2026. Register your interest and you'll
          get the launch date and nothing else.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/#register-interest"
            class="btn-sheen inline-flex items-center justify-center rounded-xl bg-[color:var(--color-amber)] px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] ring-1 ring-[color:var(--color-amber)]/40 transition hover:brightness-105"
          >
            Register your interest
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center justify-center rounded-xl border border-[color:var(--color-graphite)]/25 px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] transition hover:bg-[color:var(--color-graphite)] hover:text-white"
          >
            See pricing
          </a>
          <a
            href="/install"
            class="inline-flex items-center justify-center rounded-xl border border-[color:var(--color-graphite)]/25 px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] transition hover:bg-[color:var(--color-graphite)] hover:text-white"
          >
            Install guide
          </a>
        </div>
      </div>
    </article>
  </main>

  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<script>
  // Imports a shared module, so Astro emits this as an external /_astro/*.js
  // file under script-src 'self' — no CSP hash to drift. See
  // src/scripts/walkthrough.ts and src/scripts/lib/env.ts.
  import "../scripts/walkthrough.ts";
</script>
