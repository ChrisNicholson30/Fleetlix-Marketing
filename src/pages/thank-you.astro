---
// The welcome screen — step three of paid signup:
//   pricing card → Stripe Checkout → HERE → fleetlix.app/onboarding
//
// Stripe's success_url points here (functions/api/checkout.ts) rather than
// straight at the app, on purpose. A buyer who is bounced from a card form
// directly into a login screen has no confirmation of what they just bought and
// no idea what happens next; the receipt email arrives minutes later. This page
// is the moment to answer both, and to hand over the session id the app needs
// to provision the tenant.
//
// The order summary is filled in the browser by src/scripts/thank-you.ts, which
// reads the session back through GET /api/checkout-session — the page is
// statically rendered, so none of it is knowable at build time. Everything
// below degrades to a plain, correct thank-you if that lookup can't run.
//
// noindex, and excluded from the sitemap in astro.config.mjs.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { APP_ORIGIN, ONBOARDING_PATH, ONBOARDING_STEPS } from "../config/onboarding";
---

<Base
  title="Welcome to Fleetlix"
  description="Your Fleetlix subscription is live. Create your login and set your operation up."
  noindex={true}
>
  <Header />
  <main class="relative isolate overflow-hidden bg-[color:var(--color-graphite)] text-white">

    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-48 left-1/2 h-[640px] w-[640px] -translate-x-1/2 rounded-full bg-[color:var(--color-cyan)]/25 blur-[120px]"></div>
      <div class="absolute top-1/3 -left-32 h-[420px] w-[420px] rounded-full bg-[color:var(--color-amber)]/12 blur-[110px]"></div>
      <div class="absolute -bottom-40 right-0 h-[480px] w-[480px] rounded-full bg-[color:var(--color-success)]/10 blur-[120px]"></div>
      <svg class="absolute inset-0 h-full w-full opacity-[0.05]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="thanks-grid" width="44" height="44" patternUnits="userSpaceOnUse">
            <path d="M 44 0 L 0 0 0 44" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#thanks-grid)"/>
      </svg>
    </div>

    <section class="relative mx-auto flex max-w-3xl flex-col items-center px-6 py-20 text-center">

      <div class="relative mb-10 reveal reveal-1">
        <div class="absolute inset-0 rounded-full bg-[color:var(--color-cyan)]/40 blur-3xl"></div>
        <div class="badge-pop relative flex h-28 w-28 items-center justify-center rounded-full bg-[color:var(--color-cyan)] shadow-[0_20px_60px_-15px_rgba(0,166,200,0.6)] ring-1 ring-white/20">
          <svg viewBox="0 0 52 52" class="h-14 w-14" aria-hidden="true">
            <circle class="check-circle" cx="26" cy="26" r="24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <path class="check-path" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" d="M14 27 l8 8 l16 -18"/>
          </svg>
        </div>
      </div>

      <p class="reveal reveal-2 text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-amber)]">
        Payment successful
      </p>

      <h1 class="reveal reveal-3 mt-5 font-[family-name:var(--font-display)] text-5xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">
        Welcome to<br/>
        <span class="bg-gradient-to-r from-white via-white to-[color:var(--color-cyan)] bg-clip-text text-transparent">
          Fleetlix.
        </span>
      </h1>

      <p class="reveal reveal-4 mt-8 max-w-xl text-lg leading-relaxed text-white/70 md:text-xl">
        Thank you for your business — we don't take it lightly. You've just
        backed a UK-built platform that's out to change how fleets run, and
        we'll do right by you. Here's what happens next.
      </p>

      <!-- Test-mode and preview strips. Both start hidden and are revealed by
           src/scripts/thank-you.ts. A test-mode signup is otherwise pixel-
           identical to a real one, which is how you end up believing you've
           taken money you haven't. -->
      <p
        data-testmode
        hidden
        class="reveal reveal-4 mt-6 rounded-lg border border-[color:var(--color-amber)]/40 bg-[color:var(--color-amber)]/10 px-4 py-2.5 text-sm font-semibold text-[color:var(--color-amber)]"
      >
        Stripe test mode — no money changed hands.
      </p>
      <p
        data-demo
        hidden
        class="reveal reveal-4 mt-6 rounded-lg border border-white/20 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white/70"
      >
        Preview only — sample order, no checkout took place.
      </p>

      <!-- Order summary. Hidden until the script knows there is a session to
           describe, so someone who reaches this page without one sees a clean
           thank-you rather than an empty table of dashes. -->
      <div
        data-order
        hidden
        class="reveal reveal-5 mt-12 w-full rounded-2xl border border-white/12 bg-white/[0.04] p-6 text-left backdrop-blur sm:p-7"
      >
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
          Your subscription
        </p>

        <dl data-order-row="details" class="mt-5 space-y-4">
          <div data-order-row="plan" hidden class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <dt class="text-sm text-white/55">Plan</dt>
            <dd data-order-plan class="font-semibold text-white sm:text-right">&mdash;</dd>
          </div>
          <div data-order-row="trial" hidden class="flex flex-col gap-1 border-t border-white/8 pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <dt class="text-sm text-white/55">Free trial</dt>
            <dd data-order-trial class="font-semibold text-white sm:text-right">&mdash;</dd>
          </div>
          <div data-order-row="charge" hidden class="flex flex-col gap-1 border-t border-white/8 pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <dt class="text-sm text-white/55">First payment</dt>
            <dd data-order-charge class="font-semibold text-white sm:text-right">&mdash;</dd>
          </div>
          <div data-order-row="email" hidden class="flex flex-col gap-1 border-t border-white/8 pt-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <dt class="text-sm text-white/55">Receipt sent to</dt>
            <dd data-order-email class="font-semibold break-all text-white sm:text-right">&mdash;</dd>
          </div>
        </dl>

        <p data-order-row="state" data-order-state hidden class="text-white/70"></p>

        <!-- Cancellation is stated here, not just in the terms, because this is
             the last screen before the app and the first place the question
             occurs. It matches /support section 10 and terms sections 13-14 —
             the same policy written for three readers. Change all three. -->
        <p class="mt-6 border-t border-white/8 pt-4 text-sm leading-relaxed text-white/50">
          Prices exclude VAT, which Stripe adds at the rate for your billing
          address. You can cancel any time from the app — see
          <a href="/support" class="font-semibold text-white/75 underline underline-offset-2 hover:text-white">support</a>
          for how billing, plan changes and refunds work.
        </p>
      </div>

      <!-- What happens next. Three steps because the app has three; padding
           this out to look substantial would just make the first one harder to
           find. -->
      <div class="reveal reveal-5 mt-14 w-full text-left">
        <h2 class="text-center font-[family-name:var(--font-display)] text-2xl font-bold tracking-tight">
          What happens next
        </h2>

        <ol class="mt-8 space-y-5">
          {ONBOARDING_STEPS.map((step, i) => (
            <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:gap-5 sm:p-6">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-cyan)]/15 font-[family-name:var(--font-display)] text-sm font-bold text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/30"
              >
                {i + 1}
              </span>
              <div>
                <p class="font-semibold text-white">
                  {step.title}
                  {step.owner === "app" && (
                    <span class="ml-2 align-middle rounded-full bg-white/8 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-white/50">
                      In the app
                    </span>
                  )}
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-white/60">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- The handoff. href is the app root as a safe default; the script
           rewrites it to /onboarding?session_id=… when the URL carries a
           well-formed one. That id is how the app confirms the paid session,
           so a link without it lands on sign-in for an account that doesn't
           exist yet. -->
      <!-- Wraps rather than overflowing: three buttons at px-7 come to roughly
           553px, which only just clears a 640px viewport once the section's
           px-6 is taken off. The global overflow-x guard would hide the
           damage; wrapping means there is none to hide. -->
      <div class="reveal reveal-6 mt-12 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-center">
        <a
          data-open-app
          href={APP_ORIGIN}
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-[color:var(--color-cyan)] px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[color:var(--color-cyan)]/30 transition hover:-translate-y-0.5 hover:brightness-110"
        >
          Create your login
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M5 12h14"/><path d="M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/install"
          class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/10"
        >
          Install on your phone
        </a>
        <!-- /support, not a mailto: this is where every paying customer lands,
             and the questions they arrive with (what happens next, when am I
             charged, how do I cancel, I never got to set a password) are all
             answered there. It is also the support URL Stripe prints on the
             receipt for this payment, so the two agree. -->
        <a
          href="/support"
          class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-white/15 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/10"
        >
          Get help
        </a>
      </div>

      <p class="reveal reveal-6 mt-6 max-w-lg text-sm leading-relaxed text-white/45">
        Nothing to install first — Fleetlix runs in the browser and installs to
        the home screen. If you get stuck at any point, reply to your receipt
        or write to us and you'll hear back within one working day.
      </p>

      <div class="reveal reveal-6 mt-16 flex items-center gap-3 text-sm text-white/45">
        <span class="h-px w-12 bg-white/20"></span>
        <span class="font-[family-name:var(--font-display)] italic">Chris &middot; founder, Fleetlix &middot; Glasgow</span>
        <span class="h-px w-12 bg-white/20"></span>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    // Fills the order summary from the Stripe session and forwards the session
    // id to the app's onboarding (paid signup).
    import "../scripts/thank-you.ts";
  </script>

  <style>
    /* Rows in the order summary carry `flex`/`sm:flex` for their laid-out
       state and are revealed by src/scripts/thank-you.ts, so they are toggled
       with the [hidden] ATTRIBUTE — Tailwind's `hidden` CLASS is a plain
       display utility and loses the cascade to `sm:flex`, which Tailwind emits
       later. Tailwind's preflight already backs [hidden] with !important; this
       restates it page-locally so a future preflight change can't quietly turn
       the placeholder rows back on beside a real payment. */
    [hidden] {
      display: none !important;
    }
    .reveal {
      opacity: 0;
      transform: translateY(12px);
      animation-duration: 0.7s;
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      animation-fill-mode: forwards;
      animation-name: reveal;
    }
    .reveal-1 { animation-delay: 0ms; }
    .reveal-2 { animation-delay: 200ms; }
    .reveal-3 { animation-delay: 300ms; }
    .reveal-4 { animation-delay: 500ms; }
    .reveal-5 { animation-delay: 700ms; }
    .reveal-6 { animation-delay: 900ms; }
    /* The reveal animation sets opacity/transform, never display — so a row
       still carrying [hidden] stays hidden. Keep it that way: animating display
       here would flash the empty placeholder rows before the fetch lands. */
    .badge-pop {
      animation: badgePop 0.6s 100ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .check-circle {
      stroke-dasharray: 160;
      stroke-dashoffset: 160;
      animation: draw 0.6s 500ms ease-out forwards;
    }
    .check-path {
      stroke-dasharray: 50;
      stroke-dashoffset: 50;
      animation: draw 0.4s 1000ms ease-out forwards;
    }
    @keyframes reveal {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes badgePop {
      0% { opacity: 0; transform: scale(0.4); }
      100% { opacity: 1; transform: scale(1); }
    }
    @keyframes draw {
      to { stroke-dashoffset: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal, .badge-pop, .check-circle, .check-path {
        animation: none;
        opacity: 1;
        transform: none;
        stroke-dashoffset: 0;
      }
    }
  </style>
</Base>
