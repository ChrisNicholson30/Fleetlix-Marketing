---
// /install — how to install the Fleetlix PWA, per device.
//
// This is a support page doing marketing work. "No app store" is one of the
// three pillars the product is sold on (see WhyPwa), and the honest cost of
// that pillar is that installing is different on every platform and invisible
// if you don't know where to look. This page is where that claim gets paid off:
// a yard manager can send one link to a driver on any handset.
//
// Design decisions that matter:
//   - TABS ARE CSS-ONLY (radios + :has() in global.css). Every platform's steps
//     are in the DOM, so all five are crawlable and the page works with JS off.
//     src/scripts/install.ts only pre-selects the tab matching the visitor's
//     device — a nicety, never load-bearing.
//   - THE ICONS ARE THE INSTRUCTIONS. A driver doesn't know what a "share
//     sheet" is, but they recognise the square-with-an-arrow the moment they see
//     it drawn. Each platform shows the glyph it wants you to hunt for.
//   - THE EXCLUSION LISTS ARE COLLAPSED, NOT CUT. A buyer specifying handsets
//     needs to know an iPhone 8 is a dead end before they order twelve of them.
//     <details> keeps that available without leading with "not supported".
//
// Content lives in src/config/install.ts. Everything here describes
// fleetlix.app — the operations PWA, a separate repo — so the Settings paths can
// go stale without anything in this repo failing. Re-check before a rollout.

import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { platforms, troubleshooting, hardwareFloor } from "../config/install";

const lastUpdated = "10 August 2026";

// The glyph each platform asks the user to find, drawn at the top of its
// instructions. iOS/iPadOS share sheet, desktop address-bar install, Android
// overflow menu.
const glyphs: Record<string, { d: string; caption: string }> = {
  iphone: {
    d: `<path d="M12 3v11"/><path d="m8.5 6.5 3.5-3.5 3.5 3.5"/><path d="M6 12.5v7a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5v-7"/>`,
    caption: "The Share button — bottom toolbar",
  },
  ipad: {
    d: `<path d="M12 3v11"/><path d="m8.5 6.5 3.5-3.5 3.5 3.5"/><path d="M6 12.5v7a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5v-7"/>`,
    caption: "The Share button — top-right toolbar",
  },
  android: {
    d: `<circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/>`,
    caption: "The ⋮ menu — top right of Chrome",
  },
  windows: {
    d: `<rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M12 8v5"/><path d="m9.5 10.5 2.5 2.5 2.5-2.5"/><path d="M8 20h8"/>`,
    caption: "The install icon — right of the address bar",
  },
  mac: {
    d: `<rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M12 8v5"/><path d="m9.5 10.5 2.5 2.5 2.5-2.5"/><path d="M8 20h8"/>`,
    caption: "The install icon — right of the address bar",
  },
};

const statusStyle: Record<string, { ring: string; dot: string; label: string }> = {
  ok: {
    ring: "border-[color:var(--color-success)]/30",
    dot: "bg-[color:var(--color-success)]",
    label: "Supported",
  },
  limited: {
    ring: "border-[color:var(--color-amber)]/40",
    dot: "bg-[color:var(--color-amber)]",
    label: "Works, but ageing",
  },
  no: {
    ring: "border-[color:var(--color-error)]/30",
    dot: "bg-[color:var(--color-error)]",
    label: "Not supported",
  },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://fleetlix.com/install#breadcrumbs",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://fleetlix.com" },
        { "@type": "ListItem", position: 2, name: "Install guide", item: "https://fleetlix.com/install" },
      ],
    },
  ],
};
---

<Base
  title="Install Fleetlix on Your Phone, Tablet or PC | Fleetlix"
  description="Install the Fleetlix app in about twenty seconds — no App Store, no Play Store. Step-by-step guides for iPhone, iPad, Android, Windows and Mac, plus which devices are supported."
>
  <Header />

  <main id="install" class="bg-[color:var(--color-offwhite)]">
    <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
      <header>
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]">
          Install guide
        </p>
        <h1 class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-[color:var(--color-graphite)] text-balance">
          Installing Fleetlix on your device
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-slate)] leading-relaxed">
          Fleetlix installs straight from your browser — there's no App Store or
          Play Store download. It takes about twenty seconds and gives you a
          proper app icon, a full-screen window with no address bar, and offline
          access to jobs already loaded on the device.
        </p>
      </header>

      <!-- Platform picker. Radios drive :has() rules in global.css; the labels
           wrap their input so has-[:checked] styles the pill, exactly as the
           pricing billing toggle does. -->
      <fieldset class="mt-10">
        <legend class="text-sm font-semibold text-[color:var(--color-graphite)]">
          Pick your device
        </legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {platforms.map((p, i) => (
            <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-[color:var(--color-mist)] bg-white px-4 py-2.5 text-sm font-semibold text-[color:var(--color-slate)] transition has-[:checked]:border-[color:var(--color-graphite)] has-[:checked]:bg-[color:var(--color-graphite)] has-[:checked]:text-white has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-[color:var(--color-cyan)]">
              <input type="radio" name="platform" id={`platform-${p.id}`} class="sr-only" checked={i === 0} />
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
              <span data-platform-label={p.id}>{p.label}</span>
            </label>
          ))}
        </div>
        <!-- Filled in by install.ts once it has guessed the device. Hidden
             rather than empty so it never reserves blank space with JS off. -->
        <p class="mt-3 text-sm text-[color:var(--color-slate)]/85" data-detected hidden></p>
      </fieldset>

      {platforms.map((p) => (
        <section data-platform={p.id} class="mt-10">
          <h2 class="sr-only">Installing on {p.label}</h2>

          <div class="flex flex-col gap-4 rounded-2xl border border-[color:var(--color-cyan)]/25 bg-[color:var(--color-cyan)]/6 p-5 sm:flex-row sm:items-center sm:gap-5">
            <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-white text-[color:var(--color-graphite)] ring-1 ring-[color:var(--color-mist)]">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[p.id].d} />
            </span>
            <div>
              <p class="text-sm font-bold text-[color:var(--color-graphite)]">
                Look for: {glyphs[p.id].caption}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-slate)]">{p.intro}</p>
            </div>
          </div>

          {p.routes.map((route) => (
            <div class="mt-6 rounded-2xl border border-[color:var(--color-mist)] bg-white p-5 sm:p-6">
              <h3 class="font-[family-name:var(--font-display)] text-lg font-bold text-[color:var(--color-graphite)]">
                {route.name}
              </h3>
              <ol class="mt-4 space-y-3">
                {route.steps.map((step, i) => (
                  <li class="flex items-start gap-3.5">
                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-graphite)] font-[family-name:var(--font-display)] text-xs font-bold text-white tabular-nums">
                      {i + 1}
                    </span>
                    <span class="pt-0.5 leading-relaxed text-[color:var(--color-slate)]">{step}</span>
                  </li>
                ))}
              </ol>
              {route.note && (
                <p class="mt-4 rounded-lg bg-[color:var(--color-offwhite)] px-4 py-3 text-sm leading-relaxed text-[color:var(--color-slate)]">
                  {route.note}
                </p>
              )}
            </div>
          ))}

          {p.alerts && (
            <div class="mt-6 rounded-2xl border border-[color:var(--color-amber)]/35 bg-[color:var(--color-amber)]/8 p-5">
              <p class="flex items-center gap-2 font-bold text-[color:var(--color-graphite)]">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" />
                </svg>
                Turning on job alerts
              </p>
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-slate)]">{p.alerts}</p>
            </div>
          )}

          <!-- Collapsed by default: a buyer specifying handsets needs this, a
               driver following the steps above does not. -->
          <details class="group mt-6 rounded-2xl border border-[color:var(--color-mist)] bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-[color:var(--color-graphite)]">
              Which {p.label} models work?
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-[color:var(--color-slate)] transition-transform group-open:rotate-180 motion-reduce:transition-none">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="border-t border-[color:var(--color-mist)] px-5 py-4">
              <dl class="grid gap-2 sm:grid-cols-2">
                <div class="rounded-lg bg-[color:var(--color-offwhite)] px-3.5 py-2.5">
                  <dt class="text-[10px] font-bold uppercase tracking-[0.08em] text-[color:var(--color-slate)]/70">Minimum</dt>
                  <dd class="mt-0.5 text-sm font-semibold text-[color:var(--color-graphite)]">{p.minimum}</dd>
                </div>
                <div class="rounded-lg bg-[color:var(--color-offwhite)] px-3.5 py-2.5">
                  <dt class="text-[10px] font-bold uppercase tracking-[0.08em] text-[color:var(--color-slate)]/70">Recommended</dt>
                  <dd class="mt-0.5 text-sm font-semibold text-[color:var(--color-graphite)]">{p.recommended}</dd>
                </div>
              </dl>
              <ul class="mt-4 space-y-2.5">
                {p.devices.map((d) => (
                  <li class={`rounded-lg border ${statusStyle[d.status].ring} px-3.5 py-3`}>
                    <p class="flex items-start gap-2 text-sm font-semibold text-[color:var(--color-graphite)]">
                      <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${statusStyle[d.status].dot}`} aria-hidden="true"></span>
                      <span>
                        {d.title}
                        <span class="sr-only"> — {statusStyle[d.status].label}</span>
                      </span>
                    </p>
                    <p class="mt-1 pl-4 text-sm leading-relaxed text-[color:var(--color-slate)]">{d.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </section>
      ))}

      <section class="mt-14">
        <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold text-[color:var(--color-graphite)]">
          Whatever the device
        </h2>
        <p class="mt-2 text-[color:var(--color-slate)]">
          These apply on every platform, on top of the OS versions above.
        </p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {hardwareFloor.map((item) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-[color:var(--color-mist)] bg-white px-4 py-3 text-sm text-[color:var(--color-slate)]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-[color:var(--color-success)]">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-14">
        <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold text-[color:var(--color-graphite)]">
          If something goes wrong
        </h2>
        <div class="mt-4 divide-y divide-[color:var(--color-mist)] overflow-hidden rounded-2xl border border-[color:var(--color-mist)] bg-white">
          {troubleshooting.map((t) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-[color:var(--color-graphite)]">
                {t.symptom}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-[color:var(--color-slate)] transition-transform group-open:rotate-180 motion-reduce:transition-none">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="px-5 pb-4 leading-relaxed text-[color:var(--color-slate)]">{t.fix}</p>
            </details>
          ))}
        </div>
        <p class="mt-4 text-sm text-[color:var(--color-slate)]">
          Still stuck? Email
          <a href="mailto:contact@fleetlix.com" class="underline underline-offset-2 hover:text-[color:var(--color-graphite)]">contact@fleetlix.com</a>
          with your device model and the OS version from <em>Settings → About</em>.
        </p>
      </section>

      <div class="mt-14 flex flex-wrap items-center gap-3 border-t border-[color:var(--color-mist)] pt-8">
        <a
          href="/walkthrough"
          class="btn-sheen inline-flex items-center justify-center rounded-xl bg-[color:var(--color-amber)] px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] ring-1 ring-[color:var(--color-amber)]/40 transition hover:brightness-105"
        >
          Watch the walkthrough
        </a>
        <a
          href="/#register-interest"
          class="inline-flex items-center justify-center rounded-xl border border-[color:var(--color-graphite)]/25 px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] transition hover:bg-[color:var(--color-graphite)] hover:text-white"
        >
          Register your interest
        </a>
        <p class="ml-auto text-xs text-[color:var(--color-slate)]/70">Last updated: {lastUpdated}</p>
      </div>
    </article>
  </main>

  <SiteFooter />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<script>
  // Imports a shared module, so Astro emits this as an external /_astro/*.js
  // file under script-src 'self' — no CSP hash. See src/scripts/install.ts.
  import "../scripts/install.ts";
</script>
