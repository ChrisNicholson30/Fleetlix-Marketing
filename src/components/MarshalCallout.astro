---
// Homepage pointer to Marshal, the sister product for people and quality.
// The "from" price comes from src/config/marshal.ts so it never drifts from /marshal.
import { MARSHAL_BANDS, MARSHAL_COMING_SOON } from "../config/marshal";

const fromPounds = Math.min(...MARSHAL_BANDS.flatMap((b) => (b.monthlyPence === null ? [] : [b.monthlyPence]))) / 100;
---

<section id="marshal" class="relative" aria-labelledby="marshal-callout-title">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <a
      href="/marshal"
      class="group relative grid items-center gap-8 overflow-hidden rounded-3xl bg-[color:var(--color-graphite)] p-8 text-white no-underline transition hover:brightness-110 md:grid-cols-[minmax(0,1fr)_auto] md:p-12"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-[color:var(--color-amber)]/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-[color:var(--color-cyan)]/20 blur-3xl"></div>
      <div class="relative">
        <div class="flex flex-wrap items-center gap-4">
          <img src="/marshal/marshal-logo-reversed.svg" alt="Marshal, powered by Fleetlix" width="1005" height="312" loading="lazy" decoding="async" class="h-12 w-auto sm:h-14" />
          {MARSHAL_COMING_SOON && (
            <span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-amber)]/50 bg-[color:var(--color-amber)]/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-amber)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-amber)]" aria-hidden="true"></span>
              Coming soon
            </span>
          )}
        </div>
        <h2 id="marshal-callout-title" class="mt-6 max-w-2xl font-[family-name:var(--font-display)] text-2xl font-bold tracking-tight text-white md:text-3xl text-balance">
          Your people and your quality records, in one app.
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-white/75">
          Marshal is our app for HR and quality. It covers clock-in at the gate or on a phone, timesheets and lateness, fit-to-drive checks, signed policies and one-button DVSA, FORS and ISO 9001 audit packs.{" "}
          {MARSHAL_COMING_SOON ? `Coming soon, from £${fromPounds} a month` : `From £${fromPounds} a month`}, and Fleetlix customers get 15% off.
        </p>
      </div>
      <span
        class="relative inline-flex min-h-11 items-center justify-center gap-2 justify-self-start rounded-xl bg-[color:var(--color-amber)] px-5 py-3 text-sm font-semibold text-[color:var(--color-graphite)] transition group-hover:brightness-105 md:justify-self-end"
      >
        {MARSHAL_COMING_SOON ? "See what's coming" : "Meet Marshal"}
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </a>
  </div>
</section>
