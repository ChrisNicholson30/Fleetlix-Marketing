---
// Product tour — the one place the site actually SHOWS the product. Everything
// here is hand-built from tokens + SVG (no screenshots, so it stays crisp at
// any DPI and never ships a heavy raster). The composition is a glass "office
// dispatch" browser with a "driver walk-around" phone overlapping it. Ambient
// motion (pulsing vehicle dots, self-drawing route, ticking check) lives in
// global.css and is gated behind prefers-reduced-motion.
const proof = [
  {
    title: "One shared record",
    body: "The office sees a job the moment a driver updates it. No phone calls, no re-keying, no version that only lives on one person's clipboard.",
  },
  {
    title: "Checks that route themselves",
    body: "A failed walk-around becomes a work order in a tap — the driver is snapshotted, the vehicle can flag itself off-road automatically.",
  },
  {
    title: "Compliance captured as you work",
    body: "Waste Transfer Notes and weighbridge tickets generate as PDFs from data already in the system. Nothing is re-typed.",
  },
];

const jobs = [
  { reg: "SF71 KGV", route: "Bishopbriggs to Blochairn", status: "On route", tone: "cyan" },
  { reg: "SN19 ZTP", route: "Cambuslang depot", status: "Loading", tone: "amber" },
  { reg: "SP68 HMX", route: "Coatbridge transfer", status: "Complete", tone: "success" },
];

// Literal stagger classes — Tailwind's JIT only sees static strings, so these
// can't be interpolated.
const proofStagger = ["[--stagger:240ms]", "[--stagger:320ms]", "[--stagger:400ms]"];

const checks = [
  { label: "Lights & indicators", done: true },
  { label: "Tyres & wheels", done: true },
  { label: "Brakes & lines", done: true },
  { label: "Mirrors & glass", done: false },
];
---

<section
  id="product-tour"
  class="relative isolate overflow-clip bg-[color:var(--color-graphite)] text-white"
>
  <div aria-hidden="true" class="aurora opacity-40">
    <div class="aurora-blob aurora-blob--cyan top-10 -left-24 h-[26rem] w-[26rem]"></div>
    <div class="aurora-blob aurora-blob--amber bottom-0 -right-24 h-[24rem] w-[24rem]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Copy column -->
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-amber)]" data-reveal>
          Product tour
        </p>
        <h2
          class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl md:text-4xl lg:text-5xl tracking-tight leading-[1.08] text-white [--stagger:80ms]"
          data-reveal="clip"
        >
          The office and the cab, looking at the same thing.
        </h2>
        <p class="mt-5 text-white/70 text-lg leading-relaxed [--stagger:160ms]" data-reveal>
          Dispatch on a screen in the office. Walk-around checks on a phone in
          the yard. One live database underneath, so the moment anything
          changes, everyone who needs it already knows.
        </p>

        <ul class="mt-8 space-y-5">
          {proof.map((p, i) => (
            <li class={`flex items-start gap-4 ${proofStagger[i]}`} data-reveal>
              <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[color:var(--color-cyan)]/15 text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/25">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <h3 class="font-[family-name:var(--font-display)] font-bold text-lg text-white">{p.title}</h3>
                <p class="mt-1 text-white/65 leading-relaxed">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>

        <!-- The mock above is hand-drawn CSS/SVG, not a screenshot, so a
             visitor who wants to see the real thing move has nowhere to go from
             here. /walkthrough is that destination — secondary to "Get early
             access", which stays the conversion action. -->
        <a
          href="/walkthrough"
          class="group mt-9 inline-flex items-center gap-2 text-sm font-semibold text-white/75 hover:text-white transition-colors"
          data-reveal
        >
          <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/20">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true">
              <path d="M8 5.14v13.72L19 12z" />
            </svg>
          </span>
          Watch the full walkthrough
        </a>

        <a
          href="#register-interest"
          class="group mt-5 flex items-center gap-2 font-semibold text-[color:var(--color-amber)] hover:text-white transition-colors"
        >
          Get early access
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- Device composition -->
      <div class="lg:col-span-7">
        <div class="relative mx-auto max-w-xl lg:max-w-none lg:pr-24" data-reveal="scale">
          <!-- Browser: office dispatch board -->
          <div class="relative rounded-2xl border border-white/10 bg-white/[0.03] shadow-2xl shadow-black/50 backdrop-blur-sm overflow-hidden">
            <!-- chrome -->
            <div class="flex items-center gap-3 border-b border-white/10 bg-white/[0.04] px-4 py-3">
              <div class="flex gap-1.5">
                <span class="h-3 w-3 rounded-full bg-[color:var(--color-error)]/80"></span>
                <span class="h-3 w-3 rounded-full bg-[color:var(--color-warning)]/80"></span>
                <span class="h-3 w-3 rounded-full bg-[color:var(--color-success)]/80"></span>
              </div>
              <div class="mx-auto flex items-center gap-2 rounded-md bg-black/30 px-3 py-1 text-[11px] text-white/55">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                fleetlix.app/dispatch
              </div>
            </div>

            <!-- app body -->
            <div class="flex">
              <!-- left rail -->
              <div class="hidden sm:flex w-14 flex-col items-center gap-2 border-r border-white/10 bg-black/20 py-4">
                <span class="mb-2 inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[color:var(--color-amber)] text-[color:var(--color-graphite)]">
                  <img src="/fleetlix-logo-icon.svg" alt="" class="h-4 w-4" />
                </span>
                {["M3 12h18M3 6h18M3 18h18", "M12 21s-7-4.35-7-10a7 7 0 0 1 14 0c0 5.65-7 10-7 10Z", "M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z", "M12 20V10M18 20V4M6 20v-4"].map((d, i) => (
                  <span class={`inline-flex h-8 w-8 items-center justify-center rounded-lg ${i === 0 ? "bg-white/10 text-white" : "text-white/40"}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={d} />
                    </svg>
                  </span>
                ))}
              </div>

              <!-- main -->
              <div class="flex-1 p-4 sm:p-5">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-[family-name:var(--font-display)] font-bold text-base sm:text-lg text-white">Live dispatch</p>
                    <p class="text-[11px] text-white/45">Monday · 12 vehicles active</p>
                  </div>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-success)]/15 px-2.5 py-1 text-[11px] font-semibold text-[color:var(--color-success)]">
                    <span class="live-dot h-1.5 w-1.5 rounded-full bg-[color:var(--color-success)]"></span>
                    Live
                  </span>
                </div>

                <!-- map -->
                <div class="mt-3 rounded-xl border border-white/10 bg-black/25 overflow-hidden">
                  <svg viewBox="0 0 400 176" class="w-full h-auto" role="img" aria-label="Live map of active vehicles on their routes">
                    <defs>
                      <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
                        <path d="M32 0H0V32" fill="none" stroke="rgb(255 255 255 / 0.06)" stroke-width="1" />
                      </pattern>
                    </defs>
                    <rect width="400" height="176" fill="url(#grid)" />
                    <!-- route -->
                    <path
                      class="route-draw"
                      pathLength="1"
                      d="M40 140 C 120 120, 130 60, 210 62 S 320 90, 360 40"
                      fill="none"
                      stroke="var(--color-cyan)"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      opacity="0.85"
                    />
                    <!-- start / end pins -->
                    <circle cx="40" cy="140" r="4" fill="var(--color-amber)" />
                    <circle cx="360" cy="40" r="4" fill="var(--color-cyan)" />
                    <!-- vehicles -->
                    <g transform="translate(130,88)">
                      <circle class="ping-ring" r="5" fill="var(--color-cyan)" opacity="0.45" />
                      <circle class="live-dot" r="3.5" fill="var(--color-cyan)" />
                    </g>
                    <g transform="translate(240,66)">
                      <circle class="ping-ring" r="5" fill="var(--color-amber)" opacity="0.45" style="animation-delay:0.8s" />
                      <circle class="live-dot" r="3.5" fill="var(--color-amber)" style="animation-delay:0.4s" />
                    </g>
                    <g transform="translate(305,74)">
                      <circle class="live-dot" r="3.5" fill="var(--color-success)" style="animation-delay:1.2s" />
                    </g>
                  </svg>
                </div>

                <!-- jobs -->
                <div class="mt-3 space-y-2">
                  {jobs.map((j) => (
                    <div class="flex items-center gap-3 rounded-lg border border-white/8 bg-white/[0.03] px-3 py-2">
                      <span class="rounded bg-white/10 px-2 py-0.5 text-[11px] font-semibold tracking-wide text-white/80 tabular-nums">{j.reg}</span>
                      <span class="flex-1 truncate text-[12px] text-white/55">{j.route}</span>
                      <span class={`shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold ${
                        j.tone === "cyan"
                          ? "bg-[color:var(--color-cyan)]/15 text-[color:var(--color-cyan)]"
                          : j.tone === "amber"
                            ? "bg-[color:var(--color-amber)]/15 text-[color:var(--color-amber)]"
                            : "bg-[color:var(--color-success)]/15 text-[color:var(--color-success)]"
                      }`}>{j.status}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Phone: driver walk-around check -->
          <div class="absolute -bottom-8 right-2 lg:-right-4 w-[42%] max-w-[190px] hidden sm:block float-soft">
            <div class="rounded-[2rem] border border-white/15 bg-[color:var(--color-graphite)] p-2 shadow-2xl shadow-black/60 ring-1 ring-white/5">
              <div class="relative rounded-[1.5rem] bg-black/40 overflow-hidden">
                <!-- notch -->
                <div class="absolute left-1/2 top-1.5 z-10 h-1.5 w-12 -translate-x-1/2 rounded-full bg-white/20"></div>
                <div class="px-3 pt-6 pb-3">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[color:var(--color-amber)]">Walk-around</p>
                  <p class="mt-0.5 font-[family-name:var(--font-display)] font-bold text-sm text-white">SF71 KGV</p>

                  <div class="mt-3 space-y-1.5">
                    {checks.map((c) => (
                      <div class="flex items-center gap-2 rounded-md bg-white/[0.04] px-2 py-1.5">
                        <span class={`inline-flex h-4 w-4 items-center justify-center rounded-full ${
                          c.done
                            ? "bg-[color:var(--color-success)] text-white"
                            : "border border-white/25 text-transparent"
                        }`}>
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5" />
                          </svg>
                        </span>
                        <span class={`text-[10px] ${c.done ? "text-white/70" : "text-white/45"}`}>{c.label}</span>
                      </div>
                    ))}
                  </div>

                  <div class="mt-3 h-1.5 w-full rounded-full bg-white/10 overflow-hidden">
                    <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-[color:var(--color-amber)] to-[color:var(--color-cyan)]"></div>
                  </div>
                  <p class="mt-1.5 text-[9px] text-white/40">3 of 4 sections checked</p>

                  <div class="mt-3 rounded-lg bg-[color:var(--color-amber)] py-2 text-center text-[11px] font-bold text-[color:var(--color-graphite)]">
                    Sign &amp; submit
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
