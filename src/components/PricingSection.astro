---
// Pricing — mirrors Resources/Pricing.md (which itself mirrors the app repo's
// shared/plans/index.ts; if they disagree, the code wins). Five fixed plans,
// monthly GBP, no annual toggle, "Custom" scrapped. Every plan runs the full
// operations core; tiers differ by seat limits and commercial modules, so the
// section leads with seats and layers modules cumulatively ("Everything in X").
//
// No React island: the old billing toggle is gone, so this is a static .astro
// component — it gets data-reveal / card-glow / data-spotlight for free and
// drops one hydration bundle.
//
// CTAs server-render as #register-interest links. src/scripts/checkout.ts
// progressively enhances them: when a valid ?promo= is in the URL (e.g. the
// letsrecycle card promo), each becomes a "Start N-day free trial" button that
// creates a Stripe Checkout Session via POST /api/checkout. Promo-gated — no
// promo, no checkout. The data-checkout-cta / data-plan / data-checkout-label
// hooks below are what the script targets.

type Plan = {
  name: string;
  price: number;
  blurb: string;
  seats: { users: number; drivers: number; mechanics: number };
  inherits: string | null;
  features: string[];
  icon: string;
  accent: "amber" | "cyan";
  featured?: boolean;
  addon?: string;
};

const plans: Plan[] = [
  {
    name: "Operator",
    price: 79,
    blurb: "Sole trader, doing everything yourself.",
    seats: { users: 3, drivers: 2, mechanics: 1 },
    inherits: null,
    features: [
      "Full operations core",
      "DWTS compliance submission",
      "Basic invoicing",
      "Register-interest bookings",
    ],
    icon: `<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/>`,
    accent: "cyan",
  },
  {
    name: "Workshop",
    price: 189,
    blurb: "Small fleet with a yard and a mechanic.",
    seats: { users: 12, drivers: 8, mechanics: 4 },
    inherits: "Operator",
    features: [
      "Branded invoice PDFs",
      "Read-only customer portal",
      "Basic online cart",
      "CRM contacts",
      "Basic BI counts",
    ],
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.6-3.6a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9l-3.6 3.6z"/>`,
    accent: "amber",
  },
  {
    name: "Depot",
    price: 350,
    blurb: "A full single operation.",
    seats: { users: 40, drivers: 30, mechanics: 8 },
    inherits: "Workshop",
    features: [
      "Paid online cart",
      "Brokerage margin tracking",
      "Drag-and-drop routing",
      "Per-role dashboards",
      "Recycling & CO₂ portal",
      "Xero sync (1-way)",
    ],
    icon: `<path d="M3 21V9l9-5 9 5v12"/><path d="M9 21v-8h6v8"/>`,
    accent: "amber",
    featured: true,
  },
  {
    name: "Haulier",
    price: 550,
    blurb: "The commercial operator.",
    seats: { users: 120, drivers: 90, mechanics: 15 },
    inherits: "Depot",
    features: [
      "Map route optimisation",
      "Subcontractor logins + auto-PO",
      "Booking from the portal",
      "Custom dashboards",
      "CRM pipeline & tasks",
      "2-way Xero + QuickBooks",
    ],
    icon: `<path d="M3 6.5h11v8.5H3z"/><path d="M14 9h3.5l3 3v3H14z"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>`,
    accent: "cyan",
  },
  {
    name: "Network",
    price: 899,
    blurb: "Multi-site, multi-depot, audit-ready.",
    seats: { users: 500, drivers: 400, mechanics: 40 },
    inherits: "Haulier",
    features: [
      "Multi-depot routing",
      "BI drill-down",
      "Higher DWTS volume",
      "SSO (Google, Microsoft)",
    ],
    icon: `<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`,
    accent: "cyan",
    addon: "+ £499 one-time onboarding",
  },
];

// The operations core — identical in every plan.
const core = [
  "DVSA walk-around checks, offline + replay",
  "Kanban dispatch board + live map",
  "Weighbridge, tickets & waste capture",
  "WTN PDFs with carrier sign-off",
  "Maintenance, VOR & compliance dates",
  "Team messaging",
  "Public job-tracking links",
  "Installable, offline-capable PWA",
];

const trust: { icon: string; label: string }[] = [
  { icon: `<path d="M16 3l4 4-4 4"/><path d="M4 7h16"/><path d="M8 21l-4-4 4-4"/><path d="M20 17H4"/>`, label: "Change plan anytime" },
  { icon: `<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>`, label: "Cancel anytime" },
  { icon: `<path d="M4 21V4"/><path d="M4 4h12l-2 4 2 4H4"/>`, label: "UK-built, EU-hosted" },
  { icon: `<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13"/><path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"/>`, label: "EU data residency" },
];

// Literal stagger classes so Tailwind's JIT emits them.
const stagger = [
  "[--stagger:0ms]",
  "[--stagger:70ms]",
  "[--stagger:140ms]",
  "[--stagger:210ms]",
  "[--stagger:280ms]",
];
---

<section id="pricing" class="overflow-clip bg-[color:var(--color-offwhite)] border-y border-[color:var(--color-mist)]">
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]" data-reveal>Pricing</p>
      <h2 class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl md:text-4xl lg:text-5xl text-[color:var(--color-graphite)] tracking-tight [--stagger:80ms]" data-reveal="clip">
        Five plans. One product. No locked doors.
      </h2>
      <p class="mt-4 text-[color:var(--color-slate)] text-lg [--stagger:160ms]" data-reveal>
        Every plan runs the full operations platform — the tiers differ by team
        size and which commercial modules are unlocked. Prices per month, GBP.
      </p>
    </div>

    <!-- Plan cards -->
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
      {plans.map((p, i) => (
        <article
          class={`card-glow group relative flex flex-col rounded-2xl p-6 transition duration-300 hover:-translate-y-1 ${
            p.featured
              ? "ring-gradient text-white shadow-2xl shadow-[color:var(--color-graphite)]/25"
              : "bg-white border border-[color:var(--color-mist)] hover:border-[color:var(--color-graphite)]/15 hover:shadow-xl hover:shadow-[color:var(--color-graphite)]/5"
          } ${p.accent === "amber" ? "glow-amber" : "glow-cyan"} ${stagger[i]}`}
          data-reveal
          data-spotlight
        >
          {p.featured && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[color:var(--color-amber)] px-3 py-1 text-xs font-bold text-[color:var(--color-graphite)] whitespace-nowrap">
              Most popular
            </div>
          )}

          <div class="flex items-center gap-2.5">
            <span class={`inline-flex h-9 w-9 items-center justify-center rounded-lg ${
              p.accent === "amber"
                ? "bg-[color:var(--color-amber)]/15 text-[color:var(--color-amber)] ring-1 ring-[color:var(--color-amber)]/25"
                : "bg-[color:var(--color-cyan)]/15 text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/25"
            }`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
            </span>
            <h3 class={`font-[family-name:var(--font-display)] font-bold text-lg ${p.featured ? "text-white" : "text-[color:var(--color-graphite)]"}`}>
              {p.name}
            </h3>
          </div>

          <p class={`mt-2 text-sm min-h-[2.5rem] ${p.featured ? "text-white/70" : "text-[color:var(--color-slate)]"}`}>{p.blurb}</p>

          <div class="mt-4">
            <span class={`font-[family-name:var(--font-display)] font-extrabold text-4xl tracking-tight ${p.featured ? "text-white" : "text-[color:var(--color-graphite)]"}`}>
              £{p.price}
            </span>
            <span class={`text-sm ml-1 ${p.featured ? "text-white/60" : "text-[color:var(--color-slate)]"}`}>/mo</span>
            {p.addon && (
              <p class={`mt-1 text-xs ${p.featured ? "text-white/55" : "text-[color:var(--color-slate)]/80"}`}>{p.addon}</p>
            )}
          </div>

          <!-- Seat limits — the defining axis of the tiers. Rows (not columns):
               at xl the five-across cards leave ~47px per column, which can't
               fit the "Mechanics" label at any legible size. -->
          <dl class={`mt-4 rounded-xl px-3.5 divide-y ${
            p.featured
              ? "bg-white/8 border border-white/10 divide-white/10"
              : "bg-[color:var(--color-offwhite)] border border-[color:var(--color-mist)] divide-[color:var(--color-mist)]"
          }`}>
            {[
              { v: p.seats.users, l: "Users" },
              { v: p.seats.drivers, l: "Drivers" },
              { v: p.seats.mechanics, l: "Mechanics" },
            ].map((s) => (
              <div class="flex items-center justify-between gap-2 py-1.5">
                <dt class={`text-[10px] font-medium tracking-[0.08em] uppercase ${p.featured ? "text-white/50" : "text-[color:var(--color-slate)]/70"}`}>{s.l}</dt>
                <dd class={`font-[family-name:var(--font-display)] font-bold tabular-nums text-sm leading-tight ${p.featured ? "text-white" : "text-[color:var(--color-graphite)]"}`}>{s.v}</dd>
              </div>
            ))}
          </dl>

          <ul class={`mt-4 space-y-2 text-sm ${p.featured ? "text-white/75" : "text-[color:var(--color-slate)]"}`}>
            {p.inherits && (
              <li class={`font-semibold ${p.featured ? "text-[color:var(--color-amber)]" : "text-[color:var(--color-cyan)]"}`}>
                Everything in {p.inherits}, plus:
              </li>
            )}
            {p.features.map((f) => (
              <li class="flex items-start gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={`mt-0.5 shrink-0 ${p.featured ? "text-[color:var(--color-amber)]" : "text-[color:var(--color-success)]"}`}>
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <a
            href="#register-interest"
            data-checkout-cta
            data-plan={p.name.toLowerCase()}
            class={`mt-auto pt-5 block`}
          >
            <span class={`btn-sheen block rounded-xl px-4 py-2.5 text-center text-sm font-semibold transition ${
              p.featured
                ? "bg-[color:var(--color-amber)] text-[color:var(--color-graphite)] hover:brightness-105 ring-1 ring-[color:var(--color-amber)]/40"
                : "border border-[color:var(--color-graphite)]/25 text-[color:var(--color-graphite)] hover:bg-[color:var(--color-graphite)] hover:text-white"
            }`}>
              <span data-checkout-label>Register interest</span>
            </span>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-6 text-sm text-[color:var(--color-slate)]/80" data-reveal>
      Depot unlocks each module's <em>core</em> — Haulier unlocks its <em>power</em> version.
      Seat limits are enforced in the database, not just the UI.
    </p>

    <!-- The operations core: identical in every plan -->
    <div class="mt-12 grid lg:grid-cols-12 gap-5" data-reveal>
      <div class="lg:col-span-8 rounded-2xl bg-white border border-[color:var(--color-mist)] p-6 md:p-7">
        <p class="font-[family-name:var(--font-display)] font-bold text-[color:var(--color-graphite)]">
          In every plan — the full operations core
        </p>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5">
          {core.map((label) => (
            <div class="flex items-start gap-2 text-sm text-[color:var(--color-slate)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-[color:var(--color-success)]">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {label}
            </div>
          ))}
        </div>
      </div>

      <!-- DWTS: compliance is the floor, not a feature -->
      <div class="lg:col-span-4 rounded-2xl bg-[color:var(--color-graphite)] text-white p-6 md:p-7 flex flex-col">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--color-cyan)]/15 text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/25">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v6c0 4-3 6.5-7 9-4-2.5-7-5-7-9V6l7-3Z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </span>
        <p class="mt-4 font-[family-name:var(--font-display)] font-bold text-lg">
          DWTS is the floor, not a feature.
        </p>
        <p class="mt-2 text-sm text-white/70 leading-relaxed">
          DEFRA Digital Waste Tracking is a legal mandate — so every plan
          submits to DWTS. Only submission volume scales with tier; the
          capability never does.
        </p>
        <a href="#compliance" class="group mt-auto pt-4 inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-cyan)] hover:text-white transition-colors">
          See the deadlines
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Trust row -->
    <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 pt-6 border-t border-[color:var(--color-mist)] text-sm text-[color:var(--color-slate)]">
      {trust.map((t) => (
        <div class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[color:var(--color-slate)]/60" set:html={t.icon} />
          {t.label}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Promo-gated checkout enhancement. Imports a shared module, so Astro emits
  // it as an external /_astro/*.js file under script-src 'self' (no CSP hash).
  import "../scripts/checkout.ts";
</script>
