---
const audiences = [
  {
    accent: "cyan",
    title: "Skip-hire operators",
    body: "Running 1–50 vehicles, currently on paper or basic ticketing software.",
    icon: `<path d="M2.5 9h19l-1.2 8.2a2 2 0 0 1-2 1.8H5.7a2 2 0 0 1-2-1.8L2.5 9Z"/><path d="M6 9V6h12v3"/><path d="M9 13h6"/>`,
  },
  {
    accent: "amber",
    title: "Small-to-medium hauliers",
    status: "From May 2027",
    body: "Under 50 vehicles — the bottom 90% of the UK's ~57,000 licensed operators. Dedicated haulage workflows are on the roadmap.",
    icon: `<path d="M3 6.5h11v8.5H3z"/><path d="M14 9h3.5l3 3v3H14z"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>`,
  },
  {
    accent: "cyan",
    title: "Waste collectors",
    body: "Trade waste, mixed waste, and aggregate sectors. Modern tools at non-enterprise prices.",
    icon: `<path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6.5 7l1 12a2 2 0 0 0 2 1.9h5a2 2 0 0 0 2-1.9l1-12"/><path d="M10.5 11v5M13.5 11v5"/>`,
  },
];

const stagger = ["[--stagger:0ms]", "[--stagger:110ms]", "[--stagger:220ms]"];
---

<section id="who" class="bg-[color:var(--color-offwhite)]">
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]" data-reveal>Who it's for</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl md:text-4xl text-[color:var(--color-graphite)] tracking-tight [--stagger:80ms]" data-reveal="clip">
          Built for the underserved 90% of UK transport.
        </h2>
        <p class="mt-4 text-[color:var(--color-slate)] text-lg [--stagger:160ms]" data-reveal>
          Modern, mobile-first, five plans from £99 to £949/month plus VAT — well below the enterprise software vendors
          serving the sector, and well above the spreadsheet-and-paper status quo.
        </p>
        <p class="mt-5 inline-flex items-start gap-2.5 rounded-xl border border-[color:var(--color-mist)] bg-white px-4 py-3 text-sm text-[color:var(--color-slate)] [--stagger:240ms]" data-reveal>
          <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-amber)]/15 text-[color:var(--color-amber)]">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4l2.5 2" />
            </svg>
          </span>
          <span>
            <span class="font-semibold text-[color:var(--color-graphite)]">Waste carriers first.</span>
            Dedicated haulage support is expected May 2027 — register now and we'll tell you the moment it lands.
          </span>
        </p>
      </div>
      <div class="md:col-span-7 grid sm:grid-cols-1 gap-4">
        {audiences.map((a, i) => (
          <div
            class={`card-glow group flex items-start gap-5 rounded-2xl bg-white border border-[color:var(--color-mist)] p-7 transition duration-300 hover:-translate-y-1 hover:border-[color:var(--color-graphite)]/15 hover:shadow-xl hover:shadow-[color:var(--color-graphite)]/5 ${
              a.accent === "amber" ? "glow-amber" : "glow-cyan"
            } ${stagger[i]}`}
            data-reveal
            data-spotlight
          >
            <span class={`inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-transform duration-300 group-hover:scale-105 ${
              a.accent === "amber"
                ? "bg-[color:var(--color-amber)]/12 text-[color:var(--color-amber)] ring-1 ring-[color:var(--color-amber)]/20"
                : "bg-[color:var(--color-cyan)]/12 text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/20"
            }`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={a.icon} />
            </span>
            <div>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="font-[family-name:var(--font-display)] font-bold text-xl text-[color:var(--color-graphite)]">{a.title}</h3>
                {a.status ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-amber)]/12 px-2.5 py-0.5 text-[11px] font-semibold text-[color:var(--color-amber)] ring-1 ring-[color:var(--color-amber)]/25">
                    <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-amber)]"></span>
                    {a.status}
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-success)]/12 px-2.5 py-0.5 text-[11px] font-semibold text-[color:var(--color-success)] ring-1 ring-[color:var(--color-success)]/25">
                    <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-success)]"></span>
                    Launching first
                  </span>
                )}
              </div>
              <p class="mt-2 text-[color:var(--color-slate)]">{a.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
