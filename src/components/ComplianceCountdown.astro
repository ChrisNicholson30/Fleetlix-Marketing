---
// "Did you know?" compliance urgency band. The live countdown runs to
// Scotland's digital waste-tracking go-live (most early clients are Scottish);
// the card notes England's earlier Defra deadline. The ticking is driven by
// src/scripts/cinematic.ts (the homepage bundle) so it adds NO new CSP hash —
// the JS reads data-countdown and populates the [data-cd-*] fields.
//
// Initial tile values are computed here at build time so no-JS and pre-hydration
// visitors see a sensible (frozen-at-build) figure; the script takes over live.
const targetIso = "2027-01-01T00:00:00Z"; // 1 Jan 2027, 00:00 GMT (London winter)
const diff = Math.max(0, new Date(targetIso).getTime() - Date.now());
const totalSecs = Math.floor(diff / 1000);
const days = Math.floor(totalSecs / 86400);
const hours = Math.floor((totalSecs % 86400) / 3600);
const mins = Math.floor((totalSecs % 3600) / 60);
const secs = totalSecs % 60;
const pad = (n: number) => String(n).padStart(2, "0");

const units = [
  { label: "Days", value: String(days), attr: "data-cd-days" },
  { label: "Hours", value: pad(hours), attr: "data-cd-hours" },
  { label: "Mins", value: pad(mins), attr: "data-cd-mins" },
  { label: "Secs", value: pad(secs), attr: "data-cd-secs" },
];
---

<section id="compliance" class="relative overflow-clip bg-[color:var(--color-graphite)] text-white">
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <!-- Left: the hook -->
    <div class="lg:col-span-5" data-reveal="left">
      <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]">
        Did you know?
      </p>
      <h2 class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl md:text-4xl lg:text-5xl tracking-tight leading-[1.06] text-white">
        Waste transfer notes<br class="hidden sm:block" /> are going digital.
      </h2>
      <p class="mt-5 text-white/70 text-lg leading-relaxed">
        From 1 January 2027, waste operators across Scotland must record every
        movement digitally and file it through the new digital waste tracking
        service, with the rest of the chain following. Fleetlix captures the data
        as you work and submits it for you, so compliance is built in, not bolted on.
      </p>
      <a
        href="#faq"
        class="group mt-6 inline-flex items-center gap-2 text-[color:var(--color-cyan)] font-semibold hover:text-white transition-colors"
      >
        How we keep you compliant
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Right: England deadline card + Scotland countdown -->
    <div class="lg:col-span-7" data-reveal="right">
      <div class="rounded-2xl border border-white/12 bg-white/[0.04] p-6 sm:p-7 backdrop-blur-md">
        <div class="flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[color:var(--color-cyan)]/15 text-[color:var(--color-cyan)]">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="4.5" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.8" />
              <path d="M3 9h18M8 3v3M16 3v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              <circle cx="15.5" cy="14.5" r="3.2" fill="currentColor" opacity="0.18" />
              <path d="M15.5 13v1.6l1 .9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div>
            <p class="text-xs font-semibold tracking-[0.16em] uppercase text-[color:var(--color-cyan)]">
              New law · Mandatory from
            </p>
            <p class="mt-1 font-[family-name:var(--font-display)] font-bold text-2xl sm:text-3xl text-white">
              October 2026
            </p>
            <p class="mt-2 text-white/65 leading-relaxed">
              Licensed waste receiving sites in England must record movements
              digitally and submit them to Defra.
            </p>
          </div>
        </div>
      </div>

      <!-- Live countdown to Scotland's go-live -->
      <div class="mt-6">
        <p class="text-xs font-semibold tracking-[0.16em] uppercase text-white/45">
          Scotland goes live · 1 January 2027
        </p>
        <p class="sr-only">
          Scotland's digital waste tracking mandate takes effect on 1 January 2027.
        </p>
        <div
          class="mt-3 grid grid-cols-4 gap-2 sm:gap-4"
          data-countdown={targetIso}
          aria-hidden="true"
        >
          {units.map((u) => (
            <div class="rounded-xl border border-white/12 bg-white/[0.04] px-2 py-3 sm:px-4 sm:py-5 text-center">
              <span
                class="block font-[family-name:var(--font-display)] font-bold tabular-nums text-2xl sm:text-4xl leading-none text-white"
                {...{ [u.attr]: "" }}
              >
                {u.value}
              </span>
              <span class="mt-2 block text-[10px] sm:text-xs font-medium tracking-[0.14em] uppercase text-white/45">
                {u.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
