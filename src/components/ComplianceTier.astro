---
import { COMPLIANCE } from "../config/compliance";
import { COMPLIANCE_SLUG, OPEN_PLAN_SLUGS } from "../config/checkout";
import { SUBSCRIBE_URL } from "../config/contractTerms";
import { SHOW_TERM_CONTRACTS } from "../config/featureFlags";
import { gbp } from "../config/pricing";

// Three states, in this order:
//   open        Stripe sales are open: the card is a monthly checkout.
//   onContract  Stripe is paused but term contracts are on (SHOW_TERM_CONTRACTS):
//               the card links to the app's order form. Compliance is £49 on
//               EVERY term — never discounted (the app's migration 343,
//               2026-09-27), so this card shows no term discount.
//   paused      neither: the enquiry link below.
const open = OPEN_PLAN_SLUGS.includes(COMPLIANCE_SLUG);
const onContract = !open && SHOW_TERM_CONTRACTS;
const orderHref = `${SUBSCRIBE_URL}?plan=${COMPLIANCE_SLUG}&term=24`;
---

<article id="compliance-tier" aria-labelledby="compliance-title" class="mt-8 grid scroll-mt-24 gap-8 rounded-2xl border border-[color:var(--color-cyan)]/30 bg-white p-6 md:p-8 lg:grid-cols-[1.2fr_1fr]">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
      <span class="tracking-[0.14em] uppercase text-[color:var(--color-cyan)]">Standalone DWTS portal</span>
      {open || onContract ? (
        <span class="rounded-full bg-[color:var(--color-success)]/15 px-3 py-1 text-[color:var(--color-graphite)]">Available now</span>
      ) : (
        <span class="rounded-full bg-[color:var(--color-amber)]/20 px-3 py-1 text-[color:var(--color-graphite)]">New subscriptions paused</span>
      )}
    </div>
    <h3 id="compliance-title" class="mt-4 font-[family-name:var(--font-display)] text-2xl font-bold text-[color:var(--color-graphite)]">{COMPLIANCE.name}</h3>
    <p class="mt-2 text-xl font-semibold text-[color:var(--color-graphite)]">Everything you have to file, nothing you don't.</p>
    <p class="mt-3 leading-relaxed text-[color:var(--color-slate)]">
      Record, check and confirm your DWTS submissions. For receiving sites,
      transfer stations and businesses keeping their existing software.
      No dispatch, jobs board, driver assignment or scheduling.
    </p>
    <div class="mt-5">
      <p class="text-[color:var(--color-graphite)]">
        <span class="font-[family-name:var(--font-display)] text-4xl font-extrabold">£{gbp(COMPLIANCE.monthly)}</span>
        <span class="text-sm">/month + VAT</span>
      </p>
      <p class="mt-2 text-sm font-semibold text-[color:var(--color-graphite)]">
        A dedicated portal for DWTS submissions.
      </p>
      <p class="mt-1 text-sm text-[color:var(--color-slate)]">
        {onContract
          ? "On a 24, 36, 48 or 60-month contract: the same £49 on every term, billed monthly by bank transfer. No free trial."
          : "Monthly billing only. No free trial."}
      </p>
    </div>
    <!-- Self-serve: pay on Stripe → /thank-you → create your login on
         fleetlix.app/onboarding → straight into /compliance. [data-open-checkout]
         is wired by src/scripts/checkout.ts (loaded by PricingSection). With JS
         off the href falls back to the Compliance enquiry on the homepage form.
         No promo, no trial, monthly only — functions/api/checkout.ts checks the
         £49 price before selling it. While sales are paused the hook is left
         off, so this is only ever the enquiry link. -->
    <a
      href={onContract ? orderHref : "#register-compliance"}
      {...(open ? { "data-open-checkout": "" } : {})}
      data-plan={COMPLIANCE_SLUG}
      class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-[color:var(--color-graphite)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[color:var(--color-graphite)]/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--color-cyan)]"
    >
      <span data-checkout-label>{open ? "Start Fleetlix Compliance" : onContract ? "Order Fleetlix Compliance" : "Register interest"}</span>
    </a>
    <p class="mt-3 text-xs leading-relaxed text-[color:var(--color-slate)]">
      {open
        ? "Secure checkout by Stripe. Create your login straight after paying and you are taken into your records. Cancel any time."
        : onContract
          ? "Confirm your email, read and sign your Order Form online, and your account opens as soon as your first invoice is paid."
          : "Not on sale for the moment while we change how we take payments. Register your interest and we'll let you know when it reopens."}
    </p>
  </div>
  <div class="min-w-0 rounded-xl bg-[color:var(--color-offwhite)] p-5 md:p-6">
    <p class="font-semibold text-[color:var(--color-graphite)]">Built around the filing obligation</p>
    <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-slate)]">
      {COMPLIANCE.users} users · Planned allowance: {COMPLIANCE.submissions} DWTS submissions per calendar month.
      Fair use — the allowance does not block a filing.
    </p>
    <ul class="mt-5 space-y-3">
      {COMPLIANCE.features.map((feature) => (
        <li class="flex items-start gap-3 text-sm text-[color:var(--color-slate)]">
          <svg class="mt-0.5 shrink-0 text-[color:var(--color-cyan)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
          {feature}
        </li>
      ))}
    </ul>
    <p class="mt-5 border-t border-[color:var(--color-mist)] pt-4 text-sm leading-relaxed text-[color:var(--color-slate)]">
      Carrier-register checks are recorded by a person; there is no automatic register lookup.
    </p>
  </div>
</article>
