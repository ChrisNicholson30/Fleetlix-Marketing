---
// Broker Network — the second price ladder, rendered directly below the
// operator pricing cards on the homepage.
//
// This section is a TEASER, not the offer. It carries the two rungs, the free
// tier's limits, and the eligibility line; the referral mechanics and the
// margin-visibility table live at /brokers, because putting all of it here
// roughly doubles the homepage on the main conversion path.
//
// Two things must survive any edit:
//   1. THE ELIGIBILITY LINE. Without "intermediaries only — no owned fleet",
//      every Operator at £99 reclassifies as a free broker.
//   2. "+ VAT" on the £249. House rule, and FLEETLIX LTD is VAT registered.
//
// The October 2027 date is read from src/config/dwts.ts, not typed.
import {
  BROKER_TIERS,
  BROKER_LIMITS,
  BROKER_RAIL,
  BROKER_LAUNCH,
  BROKER_DWTS_MILESTONE,
  ELIGIBILITY,
} from "../config/brokers";

const stagger = ["[--stagger:0ms]", "[--stagger:120ms]"];
---

<section
  id="brokers"
  class="relative overflow-clip bg-[color:var(--color-offwhite)]"
>
  <!-- No border-y: PricingSection above and Faq below both carry one, and two
       adjacent light sections each drawing their own gives a doubled 2px rule.
       Same alternation rule WhoFor follows. -->
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold tracking-[0.18em] uppercase text-[color:var(--color-cyan)]"
        data-reveal
      >
        Broker Network
      </p>
      <h2
        class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-3xl md:text-4xl text-[color:var(--color-graphite)] tracking-tight text-balance [--stagger:80ms]"
        data-reveal="clip"
      >
        Two rungs for brokers. One of them is free.
      </h2>
      <p class="mt-4 text-[color:var(--color-slate)] text-lg [--stagger:160ms]" data-reveal>
        Free connects the panel you already have. Pro grows and defends the
        panel you want. Digital waste tracking is included on both — brokers
        must file from{" "}
        <a href="/digital-waste-tracking" class="font-semibold text-[color:var(--color-graphite)] underline underline-offset-2 hover:text-[color:var(--color-cyan)]">
          {BROKER_DWTS_MILESTONE.dateLabel}
        </a>, and we do not charge for it.
      </p>
    </div>

    <!-- The two rungs -->
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {BROKER_TIERS.map((tier, i) => (
        <article
          class={`card-glow ${tier.accent === "amber" ? "glow-amber" : "glow-cyan"} group relative flex flex-col rounded-2xl border bg-white p-7 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[color:var(--color-graphite)]/5 ${
            tier.featured
              ? "border-[color:var(--color-amber)]/40 shadow-lg shadow-[color:var(--color-amber)]/5"
              : "border-[color:var(--color-mist)]"
          } ${stagger[i]}`}
          data-reveal
          data-spotlight
        >
          <div class="flex items-start justify-between gap-4">
            <div
              class={`inline-flex h-11 w-11 items-center justify-center rounded-xl ${
                tier.accent === "amber"
                  ? "bg-[color:var(--color-amber)]/12 text-[color:var(--color-amber)] ring-1 ring-[color:var(--color-amber)]/20"
                  : "bg-[color:var(--color-cyan)]/12 text-[color:var(--color-cyan)] ring-1 ring-[color:var(--color-cyan)]/20"
              }`}
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tier.icon} />
            </div>
            {tier.featured && (
              <span class="inline-flex items-center rounded-full bg-[color:var(--color-amber)]/12 px-2.5 py-0.5 text-[11px] font-semibold text-[color:var(--color-amber)] ring-1 ring-[color:var(--color-amber)]/25">
                Earn it, or buy it
              </span>
            )}
          </div>

          <h3 class="mt-5 font-[family-name:var(--font-display)] font-bold text-xl text-[color:var(--color-graphite)]">
            {tier.name}
          </h3>
          <p class="mt-1 text-[color:var(--color-slate)]">{tier.blurb}</p>

          <div class="mt-5 flex items-baseline gap-2">
            <span
              class={`font-[family-name:var(--font-display)] text-4xl font-extrabold tabular-nums ${
                tier.accent === "amber"
                  ? "text-[color:var(--color-amber)]"
                  : "text-[color:var(--color-graphite)]"
              }`}
            >
              {tier.price}
            </span>
          </div>
          <p class="mt-1 text-sm text-[color:var(--color-slate)]/80">{tier.priceNote}</p>

          <dl class="mt-6 space-y-2 border-t border-[color:var(--color-mist)] pt-5 text-sm">
            {BROKER_LIMITS.map((row) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-[color:var(--color-slate)]">{row.label}</dt>
                <dd class="font-semibold tabular-nums text-[color:var(--color-graphite)]">
                  {tier.slug === "broker-free" ? row.free : row.pro}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <!-- The rail: what both rungs get. This is the offer — the paid rung adds
         reach, not function, and a broker on Free is never stuck. -->
    <div
      class="mt-10 rounded-2xl border border-[color:var(--color-mist)] bg-white p-6 sm:p-8 [--stagger:200ms]"
      data-reveal
    >
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-slate)]/60">
        Included on both rungs
      </p>
      <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {BROKER_RAIL.map((f) => (
          <li class="flex items-start gap-2.5 text-sm text-[color:var(--color-slate)]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-[color:var(--color-success)]">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {f.label}
          </li>
        ))}
      </ul>
    </div>

    <!-- Eligibility. Load-bearing, so it sits on screen rather than in a
         footnote: without it the operator ladder has an obvious free door. -->
    <p
      class="mt-6 max-w-3xl text-sm leading-relaxed text-[color:var(--color-slate)]/80 [--stagger:240ms]"
      data-reveal
    >
      {ELIGIBILITY}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3 [--stagger:280ms]" data-reveal>
      <a
        href="/brokers"
        class="btn-sheen inline-flex items-center justify-center gap-2 rounded-xl bg-[color:var(--color-amber)] px-6 py-3 text-base font-semibold text-[color:var(--color-graphite)] ring-1 ring-[color:var(--color-amber)]/40 transition hover:brightness-105"
      >
        See how the Broker Network works
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <span class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-mist)] bg-white px-3.5 py-1.5 text-sm font-medium text-[color:var(--color-slate)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-amber)]" aria-hidden="true"></span>
        Opens <time datetime={BROKER_LAUNCH.iso}>{BROKER_LAUNCH.label}</time>
      </span>
    </div>
  </div>
</section>
